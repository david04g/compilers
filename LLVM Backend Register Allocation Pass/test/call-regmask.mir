# RUN: %llc -mtriple=x86_64-unknown-linux-gnu -verify-machineinstrs -load %custom_ra -regalloc=custom-ra -custom-ra-trace=%t.trace -stop-after=virtregrewriter %s -o - | %FileCheck %s
# RUN: %FileCheck --check-prefix=TRACE %s < %t.trace

# CHECK-LABEL: name: call_regmask
# CHECK-NOT: %{{[0-9]+}}:
# TRACE: custom-ra trace for call_regmask
# TRACE: phys=$

--- |
  declare void @callee()

  define i64 @call_regmask(i64 %a) {
  entry:
    call void @callee()
    ret i64 %a
  }
...
---
name: call_regmask
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $rdi

    %0:gr64 = COPY $rdi
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def dead $rsp, implicit-def $ssp, implicit-def $eflags, implicit $rsp, implicit $ssp
    CALL64pcrel32 @callee, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp
    ADJCALLSTACKUP64 0, 0, implicit-def dead $rsp, implicit-def $ssp, implicit-def $eflags, implicit $rsp, implicit $ssp
    $rax = COPY %0
    RET64 $rax
...
