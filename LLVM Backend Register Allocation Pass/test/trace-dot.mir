# RUN: rm -f %t.dot %t.trace
# RUN: %llc -mtriple=x86_64-unknown-linux-gnu -verify-machineinstrs -load %custom_ra -regalloc=custom-ra -custom-ra-debug -custom-ra-dot=%t.dot -custom-ra-trace=%t.trace -stop-after=virtregrewriter %s -o - > %t.out
# RUN: %FileCheck --check-prefix=TRACE %s < %t.trace
# RUN: %FileCheck --check-prefix=DOT %s < %t.dot

# TRACE: custom-ra trace for trace_dot
# TRACE: allocation:
# TRACE: phys=$
# TRACE: custom-ra trace for trace_dot_second
# DOT: graph custom_ra_interference

--- |
  define i64 @trace_dot(i64 %a, i64 %b, i64 %c) {
  entry:
    %x = add i64 %a, %b
    %y = add i64 %x, %c
    ret i64 %y
  }

  define i64 @trace_dot_second(i64 %a) {
  entry:
    ret i64 %a
  }
...
---
name: trace_dot
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $rdi, $rsi, $rdx

    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %2:gr64 = COPY $rdx
    %3:gr64 = ADD64rr %0, %1, implicit-def dead $eflags
    %4:gr64 = ADD64rr %3, %2, implicit-def dead $eflags
    $rax = COPY %4
    RET64 $rax
...
---
name: trace_dot_second
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $rdi

    %0:gr64 = COPY $rdi
    $rax = COPY %0
    RET64 $rax
...
