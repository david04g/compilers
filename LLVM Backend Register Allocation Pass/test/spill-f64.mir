# RUN: rm -f "%t.trace"
# RUN: %llc -verify-machineinstrs -load "%custom_ra" -regalloc=custom-ra -custom-ra-trace="%t.trace" -start-after=finalize-isel -stop-after=virtregrewriter "%s" -o "%t.mir"
# RUN: %FileCheck --check-prefix=TRACE "%s" < "%t.trace"
# RUN: %FileCheck --check-prefix=MIR "%s" < "%t.mir"
# RUN: %llc -verify-machineinstrs -load "%custom_ra" -regalloc=custom-ra -start-after=finalize-isel -stop-after=virtregrewriter "%s" -o "%t.second.mir"
# RUN: diff "%t.mir" "%t.second.mir"
# TRACE: spill: round=
# TRACE-SAME: stack-slot=fi#
# TRACE: allocation-complete:
# MIR: type: spill-slot
# MIR: body:
# MIR-NOT: %{{[0-9]+}}:
# MIR: %stack.

--- |
  ; Generated pressure regression
  source_filename = "pressure.ll"
  target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

  declare void @barrier()

  define double @work(ptr %p, i64 %count) {
  entry:
    %p01 = bitcast ptr %p to ptr
    %v0 = load volatile double, ptr %p01, align 8
    %p1 = getelementptr double, ptr %p, i64 1
    %v1 = load volatile double, ptr %p1, align 8
    %p2 = getelementptr double, ptr %p, i64 2
    %v2 = load volatile double, ptr %p2, align 8
    %p3 = getelementptr double, ptr %p, i64 3
    %v3 = load volatile double, ptr %p3, align 8
    %p4 = getelementptr double, ptr %p, i64 4
    %v4 = load volatile double, ptr %p4, align 8
    %p5 = getelementptr double, ptr %p, i64 5
    %v5 = load volatile double, ptr %p5, align 8
    %p6 = getelementptr double, ptr %p, i64 6
    %v6 = load volatile double, ptr %p6, align 8
    %p7 = getelementptr double, ptr %p, i64 7
    %v7 = load volatile double, ptr %p7, align 8
    %p8 = getelementptr double, ptr %p, i64 8
    %v8 = load volatile double, ptr %p8, align 8
    %p9 = getelementptr double, ptr %p, i64 9
    %v9 = load volatile double, ptr %p9, align 8
    %p10 = getelementptr double, ptr %p, i64 10
    %v10 = load volatile double, ptr %p10, align 8
    %p11 = getelementptr double, ptr %p, i64 11
    %v11 = load volatile double, ptr %p11, align 8
    %p12 = getelementptr double, ptr %p, i64 12
    %v12 = load volatile double, ptr %p12, align 8
    %p13 = getelementptr double, ptr %p, i64 13
    %v13 = load volatile double, ptr %p13, align 8
    %p14 = getelementptr double, ptr %p, i64 14
    %v14 = load volatile double, ptr %p14, align 8
    %p15 = getelementptr double, ptr %p, i64 15
    %v15 = load volatile double, ptr %p15, align 8
    %p16 = getelementptr double, ptr %p, i64 16
    %v16 = load volatile double, ptr %p16, align 8
    %p17 = getelementptr double, ptr %p, i64 17
    %v17 = load volatile double, ptr %p17, align 8
    %p18 = getelementptr double, ptr %p, i64 18
    %v18 = load volatile double, ptr %p18, align 8
    %p19 = getelementptr double, ptr %p, i64 19
    %v19 = load volatile double, ptr %p19, align 8
    %p20 = getelementptr double, ptr %p, i64 20
    %v20 = load volatile double, ptr %p20, align 8
    %p21 = getelementptr double, ptr %p, i64 21
    %v21 = load volatile double, ptr %p21, align 8
    %p22 = getelementptr double, ptr %p, i64 22
    %v22 = load volatile double, ptr %p22, align 8
    %p23 = getelementptr double, ptr %p, i64 23
    %v23 = load volatile double, ptr %p23, align 8
    %p24 = getelementptr double, ptr %p, i64 24
    %v24 = load volatile double, ptr %p24, align 8
    %p25 = getelementptr double, ptr %p, i64 25
    %v25 = load volatile double, ptr %p25, align 8
    %p26 = getelementptr double, ptr %p, i64 26
    %v26 = load volatile double, ptr %p26, align 8
    %p27 = getelementptr double, ptr %p, i64 27
    %v27 = load volatile double, ptr %p27, align 8
    %p28 = getelementptr double, ptr %p, i64 28
    %v28 = load volatile double, ptr %p28, align 8
    %p29 = getelementptr double, ptr %p, i64 29
    %v29 = load volatile double, ptr %p29, align 8
    %p30 = getelementptr double, ptr %p, i64 30
    %v30 = load volatile double, ptr %p30, align 8
    %p31 = getelementptr double, ptr %p, i64 31
    %v31 = load volatile double, ptr %p31, align 8
    %p32 = getelementptr double, ptr %p, i64 32
    %v32 = load volatile double, ptr %p32, align 8
    %p33 = getelementptr double, ptr %p, i64 33
    %v33 = load volatile double, ptr %p33, align 8
    %p34 = getelementptr double, ptr %p, i64 34
    %v34 = load volatile double, ptr %p34, align 8
    %p35 = getelementptr double, ptr %p, i64 35
    %v35 = load volatile double, ptr %p35, align 8
    %p36 = getelementptr double, ptr %p, i64 36
    %v36 = load volatile double, ptr %p36, align 8
    %p37 = getelementptr double, ptr %p, i64 37
    %v37 = load volatile double, ptr %p37, align 8
    %p38 = getelementptr double, ptr %p, i64 38
    %v38 = load volatile double, ptr %p38, align 8
    %p39 = getelementptr double, ptr %p, i64 39
    %v39 = load volatile double, ptr %p39, align 8
    %key = load volatile double, ptr %p, align 8
    %sumfirst = fmul double %v0, %key
    %sumx0 = fmul double %v1, %key
    %sum0 = fadd double %sumfirst, %sumx0
    %sumx1 = fmul double %v2, %key
    %sum1 = fadd double %sum0, %sumx1
    %sumx2 = fmul double %v3, %key
    %sum2 = fadd double %sum1, %sumx2
    %sumx3 = fmul double %v4, %key
    %sum3 = fadd double %sum2, %sumx3
    %sumx4 = fmul double %v5, %key
    %sum4 = fadd double %sum3, %sumx4
    %sumx5 = fmul double %v6, %key
    %sum5 = fadd double %sum4, %sumx5
    %sumx6 = fmul double %v7, %key
    %sum6 = fadd double %sum5, %sumx6
    %sumx7 = fmul double %v8, %key
    %sum7 = fadd double %sum6, %sumx7
    %sumx8 = fmul double %v9, %key
    %sum8 = fadd double %sum7, %sumx8
    %sumx9 = fmul double %v10, %key
    %sum9 = fadd double %sum8, %sumx9
    %sumx10 = fmul double %v11, %key
    %sum10 = fadd double %sum9, %sumx10
    %sumx11 = fmul double %v12, %key
    %sum11 = fadd double %sum10, %sumx11
    %sumx12 = fmul double %v13, %key
    %sum12 = fadd double %sum11, %sumx12
    %sumx13 = fmul double %v14, %key
    %sum13 = fadd double %sum12, %sumx13
    %sumx14 = fmul double %v15, %key
    %sum14 = fadd double %sum13, %sumx14
    %sumx15 = fmul double %v16, %key
    %sum15 = fadd double %sum14, %sumx15
    %sumx16 = fmul double %v17, %key
    %sum16 = fadd double %sum15, %sumx16
    %sumx17 = fmul double %v18, %key
    %sum17 = fadd double %sum16, %sumx17
    %sumx18 = fmul double %v19, %key
    %sum18 = fadd double %sum17, %sumx18
    %sumx19 = fmul double %v20, %key
    %sum19 = fadd double %sum18, %sumx19
    %sumx20 = fmul double %v21, %key
    %sum20 = fadd double %sum19, %sumx20
    %sumx21 = fmul double %v22, %key
    %sum21 = fadd double %sum20, %sumx21
    %sumx22 = fmul double %v23, %key
    %sum22 = fadd double %sum21, %sumx22
    %sumx23 = fmul double %v24, %key
    %sum23 = fadd double %sum22, %sumx23
    %sumx24 = fmul double %v25, %key
    %sum24 = fadd double %sum23, %sumx24
    %sumx25 = fmul double %v26, %key
    %sum25 = fadd double %sum24, %sumx25
    %sumx26 = fmul double %v27, %key
    %sum26 = fadd double %sum25, %sumx26
    %sumx27 = fmul double %v28, %key
    %sum27 = fadd double %sum26, %sumx27
    %sumx28 = fmul double %v29, %key
    %sum28 = fadd double %sum27, %sumx28
    %sumx29 = fmul double %v30, %key
    %sum29 = fadd double %sum28, %sumx29
    %sumx30 = fmul double %v31, %key
    %sum30 = fadd double %sum29, %sumx30
    %sumx31 = fmul double %v32, %key
    %sum31 = fadd double %sum30, %sumx31
    %sumx32 = fmul double %v33, %key
    %sum32 = fadd double %sum31, %sumx32
    %sumx33 = fmul double %v34, %key
    %sum33 = fadd double %sum32, %sumx33
    %sumx34 = fmul double %v35, %key
    %sum34 = fadd double %sum33, %sumx34
    %sumx35 = fmul double %v36, %key
    %sum35 = fadd double %sum34, %sumx35
    %sumx36 = fmul double %v37, %key
    %sum36 = fadd double %sum35, %sumx36
    %sumx37 = fmul double %v38, %key
    %sum37 = fadd double %sum36, %sumx37
    %sumx38 = fmul double %v39, %key
    %sum38 = fadd double %sum37, %sumx38
    ret double %sum38
  }
...
---
name:            work
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   true
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 1, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 2, class: fr64, preferred-register: '', flags: [  ] }
