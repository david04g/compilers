body:             |
  bb.0.entry:
    liveins: $rcx

    %0:gr64 = COPY $rcx
    %2:fr64 = MOVSDrm_alt %0, 1, $noreg, 0, $noreg :: (volatile load (s64) from %ir.p01)
    %3:fr64 = MOVSDrm_alt %0, 1, $noreg, 8, $noreg :: (volatile load (s64) from %ir.p1)
    %4:fr64 = MOVSDrm_alt %0, 1, $noreg, 16, $noreg :: (volatile load (s64) from %ir.p2)
