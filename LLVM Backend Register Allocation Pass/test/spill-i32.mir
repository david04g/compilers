    %12:gr32 = MOV32rm %0, 1, $noreg, 40, $noreg :: (volatile load (s32) from %ir.p10)
    %13:gr32 = MOV32rm %0, 1, $noreg, 44, $noreg :: (volatile load (s32) from %ir.p11)
    %14:gr32 = MOV32rm %0, 1, $noreg, 48, $noreg :: (volatile load (s32) from %ir.p12)
    %15:gr32 = MOV32rm %0, 1, $noreg, 52, $noreg :: (volatile load (s32) from %ir.p13)
    %16:gr32 = MOV32rm %0, 1, $noreg, 56, $noreg :: (volatile load (s32) from %ir.p14)
    %17:gr32 = MOV32rm %0, 1, $noreg, 60, $noreg :: (volatile load (s32) from %ir.p15)
    %18:gr32 = MOV32rm %0, 1, $noreg, 64, $noreg :: (volatile load (s32) from %ir.p16)
    %19:gr32 = MOV32rm %0, 1, $noreg, 68, $noreg :: (volatile load (s32) from %ir.p17)
    %20:gr32 = MOV32rm %0, 1, $noreg, 72, $noreg :: (volatile load (s32) from %ir.p18)
    %21:gr32 = MOV32rm %0, 1, $noreg, 76, $noreg :: (volatile load (s32) from %ir.p19)
