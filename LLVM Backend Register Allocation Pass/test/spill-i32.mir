machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    liveins: $rcx

    %0:gr64 = COPY $rcx
    %2:gr32 = MOV32rm %0, 1, $noreg, 0, $noreg :: (volatile load (s32) from %ir.p01)
    %3:gr32 = MOV32rm %0, 1, $noreg, 4, $noreg :: (volatile load (s32) from %ir.p1)
    %4:gr32 = MOV32rm %0, 1, $noreg, 8, $noreg :: (volatile load (s32) from %ir.p2)
