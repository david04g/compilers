# RUN: rm -f "%t.trace"
# RUN: %llc -verify-machineinstrs -load "%custom_ra" -regalloc=custom-ra -custom-ra-trace="%t.trace" -start-after=finalize-isel -stop-after=virtregrewriter "%s" -o "%t.mir"
# RUN: %FileCheck --check-prefix=TRACE "%s" < "%t.trace"
# RUN: %FileCheck --check-prefix=MIR "%s" < "%t.mir"
# RUN: %llc -verify-machineinstrs -load "%custom_ra" -regalloc=custom-ra -start-after=finalize-isel -stop-after=virtregrewriter "%s" -o "%t.second.mir"
# RUN: diff "%t.mir" "%t.second.mir"
# TRACE: spill: round=
# TRACE-SAME: stack-slot=fi#
# TRACE: allocation-complete:
# MIR: type: spill-slot
# MIR: body:
# MIR-NOT: %{{[0-9]+}}:
# MIR: %stack.

--- |
  ; Generated pressure regression
  source_filename = "pressure.ll"
  target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"

  declare void @barrier()

  define i32 @work(ptr %p, i64 %count) {
  entry:
    %p01 = bitcast ptr %p to ptr
    %v0 = load volatile i32, ptr %p01, align 4
    %p1 = getelementptr i32, ptr %p, i64 1
    %v1 = load volatile i32, ptr %p1, align 4
    %p2 = getelementptr i32, ptr %p, i64 2
    %v2 = load volatile i32, ptr %p2, align 4
    %p3 = getelementptr i32, ptr %p, i64 3
    %v3 = load volatile i32, ptr %p3, align 4
    %p4 = getelementptr i32, ptr %p, i64 4
    %v4 = load volatile i32, ptr %p4, align 4
    %p5 = getelementptr i32, ptr %p, i64 5
    %v5 = load volatile i32, ptr %p5, align 4
    %p6 = getelementptr i32, ptr %p, i64 6
    %v6 = load volatile i32, ptr %p6, align 4
    %p7 = getelementptr i32, ptr %p, i64 7
    %v7 = load volatile i32, ptr %p7, align 4
    %p8 = getelementptr i32, ptr %p, i64 8
    %v8 = load volatile i32, ptr %p8, align 4
    %p9 = getelementptr i32, ptr %p, i64 9
    %v9 = load volatile i32, ptr %p9, align 4
    %p10 = getelementptr i32, ptr %p, i64 10
    %v10 = load volatile i32, ptr %p10, align 4
    %p11 = getelementptr i32, ptr %p, i64 11
    %v11 = load volatile i32, ptr %p11, align 4
    %p12 = getelementptr i32, ptr %p, i64 12
    %v12 = load volatile i32, ptr %p12, align 4
    %p13 = getelementptr i32, ptr %p, i64 13
    %v13 = load volatile i32, ptr %p13, align 4
    %p14 = getelementptr i32, ptr %p, i64 14
    %v14 = load volatile i32, ptr %p14, align 4
    %p15 = getelementptr i32, ptr %p, i64 15
    %v15 = load volatile i32, ptr %p15, align 4
    %p16 = getelementptr i32, ptr %p, i64 16
    %v16 = load volatile i32, ptr %p16, align 4
    %p17 = getelementptr i32, ptr %p, i64 17
    %v17 = load volatile i32, ptr %p17, align 4
    %p18 = getelementptr i32, ptr %p, i64 18
    %v18 = load volatile i32, ptr %p18, align 4
    %p19 = getelementptr i32, ptr %p, i64 19
    %v19 = load volatile i32, ptr %p19, align 4
    %p20 = getelementptr i32, ptr %p, i64 20
    %v20 = load volatile i32, ptr %p20, align 4
    %p21 = getelementptr i32, ptr %p, i64 21
    %v21 = load volatile i32, ptr %p21, align 4
    %p22 = getelementptr i32, ptr %p, i64 22
    %v22 = load volatile i32, ptr %p22, align 4
    %p23 = getelementptr i32, ptr %p, i64 23
    %v23 = load volatile i32, ptr %p23, align 4
    %p24 = getelementptr i32, ptr %p, i64 24
    %v24 = load volatile i32, ptr %p24, align 4
    %p25 = getelementptr i32, ptr %p, i64 25
    %v25 = load volatile i32, ptr %p25, align 4
    %p26 = getelementptr i32, ptr %p, i64 26
    %v26 = load volatile i32, ptr %p26, align 4
    %p27 = getelementptr i32, ptr %p, i64 27
    %v27 = load volatile i32, ptr %p27, align 4
    %p28 = getelementptr i32, ptr %p, i64 28
    %v28 = load volatile i32, ptr %p28, align 4
    %p29 = getelementptr i32, ptr %p, i64 29
    %v29 = load volatile i32, ptr %p29, align 4
    %p30 = getelementptr i32, ptr %p, i64 30
    %v30 = load volatile i32, ptr %p30, align 4
    %p31 = getelementptr i32, ptr %p, i64 31
    %v31 = load volatile i32, ptr %p31, align 4
    %p32 = getelementptr i32, ptr %p, i64 32
    %v32 = load volatile i32, ptr %p32, align 4
    %p33 = getelementptr i32, ptr %p, i64 33
    %v33 = load volatile i32, ptr %p33, align 4
    %p34 = getelementptr i32, ptr %p, i64 34
    %v34 = load volatile i32, ptr %p34, align 4
    %p35 = getelementptr i32, ptr %p, i64 35
    %v35 = load volatile i32, ptr %p35, align 4
    %p36 = getelementptr i32, ptr %p, i64 36
    %v36 = load volatile i32, ptr %p36, align 4
    %p37 = getelementptr i32, ptr %p, i64 37
    %v37 = load volatile i32, ptr %p37, align 4
    %p38 = getelementptr i32, ptr %p, i64 38
    %v38 = load volatile i32, ptr %p38, align 4
    %p39 = getelementptr i32, ptr %p, i64 39
    %v39 = load volatile i32, ptr %p39, align 4
    %key = load volatile i32, ptr %p, align 4
    %sumfirst = xor i32 %v0, %key
    %sumx0 = xor i32 %v1, %key
    %sum0 = add i32 %sumfirst, %sumx0
    %sumx1 = xor i32 %v2, %key
    %sum1 = add i32 %sum0, %sumx1
    %sumx2 = xor i32 %v3, %key
    %sum2 = add i32 %sum1, %sumx2
    %sumx3 = xor i32 %v4, %key
    %sum3 = add i32 %sum2, %sumx3
    %sumx4 = xor i32 %v5, %key
    %sum4 = add i32 %sum3, %sumx4
    %sumx5 = xor i32 %v6, %key
    %sum5 = add i32 %sum4, %sumx5
    %sumx6 = xor i32 %v7, %key
    %sum6 = add i32 %sum5, %sumx6
    %sumx7 = xor i32 %v8, %key
    %sum7 = add i32 %sum6, %sumx7
    %sumx8 = xor i32 %v9, %key
    %sum8 = add i32 %sum7, %sumx8
    %sumx9 = xor i32 %v10, %key
    %sum9 = add i32 %sum8, %sumx9
    %sumx10 = xor i32 %v11, %key
    %sum10 = add i32 %sum9, %sumx10
    %sumx11 = xor i32 %v12, %key
    %sum11 = add i32 %sum10, %sumx11
    %sumx12 = xor i32 %v13, %key
    %sum12 = add i32 %sum11, %sumx12
    %sumx13 = xor i32 %v14, %key
    %sum13 = add i32 %sum12, %sumx13
    %sumx14 = xor i32 %v15, %key
    %sum14 = add i32 %sum13, %sumx14
    %sumx15 = xor i32 %v16, %key
    %sum15 = add i32 %sum14, %sumx15
    %sumx16 = xor i32 %v17, %key
    %sum16 = add i32 %sum15, %sumx16
    %sumx17 = xor i32 %v18, %key
    %sum17 = add i32 %sum16, %sumx17
    %sumx18 = xor i32 %v19, %key
    %sum18 = add i32 %sum17, %sumx18
    %sumx19 = xor i32 %v20, %key
    %sum19 = add i32 %sum18, %sumx19
    %sumx20 = xor i32 %v21, %key
    %sum20 = add i32 %sum19, %sumx20
    %sumx21 = xor i32 %v22, %key
    %sum21 = add i32 %sum20, %sumx21
    %sumx22 = xor i32 %v23, %key
    %sum22 = add i32 %sum21, %sumx22
    %sumx23 = xor i32 %v24, %key
    %sum23 = add i32 %sum22, %sumx23
    %sumx24 = xor i32 %v25, %key
    %sum24 = add i32 %sum23, %sumx24
    %sumx25 = xor i32 %v26, %key
    %sum25 = add i32 %sum24, %sumx25
    %sumx26 = xor i32 %v27, %key
    %sum26 = add i32 %sum25, %sumx26
    %sumx27 = xor i32 %v28, %key
    %sum27 = add i32 %sum26, %sumx27
    %sumx28 = xor i32 %v29, %key
    %sum28 = add i32 %sum27, %sumx28
    %sumx29 = xor i32 %v30, %key
    %sum29 = add i32 %sum28, %sumx29
    %sumx30 = xor i32 %v31, %key
    %sum30 = add i32 %sum29, %sumx30
    %sumx31 = xor i32 %v32, %key
    %sum31 = add i32 %sum30, %sumx31
    %sumx32 = xor i32 %v33, %key
    %sum32 = add i32 %sum31, %sumx32
    %sumx33 = xor i32 %v34, %key
    %sum33 = add i32 %sum32, %sumx33
    %sumx34 = xor i32 %v35, %key
    %sum34 = add i32 %sum33, %sumx34
    %sumx35 = xor i32 %v36, %key
    %sum35 = add i32 %sum34, %sumx35
    %sumx36 = xor i32 %v37, %key
    %sum36 = add i32 %sum35, %sumx36
    %sumx37 = xor i32 %v38, %key
    %sum37 = add i32 %sum36, %sumx37
    %sumx38 = xor i32 %v39, %key
    %sum38 = add i32 %sum37, %sumx38
    ret i32 %sum38
  }
...
---
name:            work
alignment:       1
exposesReturnsTwice: false
legalized:       false
regBankSelected: false
selected:        false
failedISel:      false
tracksRegLiveness: true
hasWinCFI:       false
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
callsEHReturn:   false
callsUnwindInit: false
hasEHContTarget: false
hasEHScopes:     false
hasEHFunclets:   false
isOutlined:      false
debugInstrRef:   true
failsVerification: false
tracksDebugUserValues: false
registers:
  - { id: 0, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 1, class: gr64, preferred-register: '', flags: [  ] }
  - { id: 2, class: gr32, preferred-register: '', flags: [  ] }
