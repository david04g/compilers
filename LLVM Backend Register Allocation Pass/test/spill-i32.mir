    %23:gr32 = MOV32rm %0, 1, $noreg, 84, $noreg :: (volatile load (s32) from %ir.p21)
    %24:gr32 = MOV32rm %0, 1, $noreg, 88, $noreg :: (volatile load (s32) from %ir.p22)
    %25:gr32 = MOV32rm %0, 1, $noreg, 92, $noreg :: (volatile load (s32) from %ir.p23)
    %26:gr32 = MOV32rm %0, 1, $noreg, 96, $noreg :: (volatile load (s32) from %ir.p24)
    %27:gr32 = MOV32rm %0, 1, $noreg, 100, $noreg :: (volatile load (s32) from %ir.p25)
