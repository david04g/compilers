# RUN: %llc -mtriple=x86_64-unknown-linux-gnu -verify-machineinstrs -load %custom_ra -regalloc=custom-ra -stop-after=virtregrewriter %s -o - | %FileCheck %s

# CHECK-LABEL: name: no_spill
# CHECK-NOT: %{{[0-9]+}}:

--- |
  define i64 @no_spill(i64 %a, i64 %b) {
  entry:
    %c = add i64 %a, %b
    ret i64 %c
  }
...
---
name: no_spill
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $rdi, $rsi

    %0:gr64 = COPY $rdi
    %1:gr64 = COPY $rsi
    %2:gr64 = ADD64rr %0, %1, implicit-def dead $eflags
    $rax = COPY %2
    RET64 $rax
...
