# RUN: not %llc -mtriple=x86_64-unknown-linux-gnu -verify-machineinstrs -load %custom_ra -regalloc=custom-ra -custom-ra-trace=%t.trace -stop-after=virtregrewriter %s -o - 2>&1 | %FileCheck --check-prefix=ERR %s
# RUN: %FileCheck --check-prefix=TRACE %s < %t.trace

# ERR: custom-ra: unable to allocate
# TRACE: split-candidate=
# TRACE: spill-required

--- |
  define i64 @loop_pressure_reject() {
  entry:
    ret i64 0
  }
...
---
name: loop_pressure_reject
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1(0x80000000)

    %0:gr64 = IMPLICIT_DEF
    %1:gr64 = IMPLICIT_DEF
    %2:gr64 = IMPLICIT_DEF
    %3:gr64 = IMPLICIT_DEF
    %4:gr64 = IMPLICIT_DEF
    %5:gr64 = IMPLICIT_DEF
    %6:gr64 = IMPLICIT_DEF
    %7:gr64 = IMPLICIT_DEF
    %8:gr64 = IMPLICIT_DEF
    %9:gr64 = IMPLICIT_DEF
    %10:gr64 = IMPLICIT_DEF
    %11:gr64 = IMPLICIT_DEF
    %12:gr64 = IMPLICIT_DEF
    %13:gr64 = IMPLICIT_DEF
    %14:gr64 = IMPLICIT_DEF
    %15:gr64 = IMPLICIT_DEF
    JMP_1 %bb.1

  bb.1.loop:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)

    %16:gr64 = ADD64rr %0, %1, implicit-def dead $eflags
    %17:gr64 = ADD64rr %2, %3, implicit-def dead $eflags
    %18:gr64 = ADD64rr %4, %5, implicit-def dead $eflags
    %19:gr64 = ADD64rr %6, %7, implicit-def dead $eflags
    %20:gr64 = ADD64rr %8, %9, implicit-def dead $eflags
    %21:gr64 = ADD64rr %10, %11, implicit-def dead $eflags
    %22:gr64 = ADD64rr %12, %13, implicit-def dead $eflags
    %23:gr64 = ADD64rr %14, %15, implicit-def dead $eflags
    TEST64rr %23, %23, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2.exit:
    %24:gr64 = ADD64rr %16, %17, implicit-def dead $eflags
    %25:gr64 = ADD64rr %18, %19, implicit-def dead $eflags
    %26:gr64 = ADD64rr %20, %21, implicit-def dead $eflags
    %27:gr64 = ADD64rr %22, %23, implicit-def dead $eflags
    %28:gr64 = ADD64rr %24, %25, implicit-def dead $eflags
    %29:gr64 = ADD64rr %26, %27, implicit-def dead $eflags
    %30:gr64 = ADD64rr %28, %29, implicit-def dead $eflags
    $rax = COPY %30
    RET64 $rax
...
