# RUN: %llc -mtriple=x86_64-unknown-linux-gnu -verify-machineinstrs -load %custom_ra -regalloc=custom-ra -custom-ra-trace=%t.trace -stop-after=virtregrewriter %s -o - | %FileCheck %s
# RUN: %FileCheck --check-prefix=TRACE %s < %t.trace

# CHECK-LABEL: name: branch_no_spill
# CHECK-NOT: %{{[0-9]+}}:
# TRACE: blocks:
# TRACE: live-out={

--- |
  define i64 @branch_no_spill(i64 %a) {
  entry:
    %cond = icmp eq i64 %a, 0
    br i1 %cond, label %left, label %right
  left:
    ret i64 %a
  right:
    ret i64 %a
  }
...
---
name: branch_no_spill
tracksRegLiveness: true
body: |
  bb.0.entry:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)
    liveins: $rdi

    %0:gr64 = COPY $rdi
    TEST64rr %0, %0, implicit-def $eflags
    JCC_1 %bb.1, 4, implicit $eflags
    JMP_1 %bb.2

  bb.1.left:
    $rax = COPY %0
    RET64 $rax

  bb.2.right:
    $rax = COPY %0
    RET64 $rax
...
